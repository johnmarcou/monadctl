#!/usr/bin/env bash
set -euo pipefail

# ⚠️ This script is experimental and not officially supported - Use at your own risk.
#
# Install:
#
# $ install -m 0755 <(curl https://raw.githubusercontent.com/johnmarcou/monadctl/refs/heads/main/monadctl) /usr/local/bin/monadctl
#
# Run:
#
# $ monadctl
#
# Install a mainnet Monad node:
#
# curl -fsSL https://raw.githubusercontent.com/johnmarcou/monadctl/refs/heads/main/monadctl | bash -s -- up --network mainnet --disk nvme1n1
#

# Check if running on Ubuntu
if [[ ! -f /etc/os-release ]] || ! grep -q "^ID=ubuntu" /etc/os-release; then
  echo "Error: monadctl only runs on Ubuntu" >&2
  exit 1
fi

CONFIG_FILE="/home/monad/monad-bft/config/node.toml"
DEFAULT_NETWORK="mainnet"
DOC_URL="https://docs.monad.xyz/networks.json"

usage() {
  cat <<EOF
monadctl – command-line tool to manage a Monad node

Usage:
  monadctl config          # print node configuration
  monadctl edit            # edit node configuration
  monadctl flush           # clear workspace, database and logs
  monadctl init            # initialise node configuration
  monadctl logs            # follow monad-bft logs (default)
  monadctl reload          # reload monad configuration
  monadctl reset           # reset the node
  monadctl reset --hard    # reset the node and import latest snapshot
  monadctl restart         # restart monad services
  monadctl start           # start monad services
  monadctl status          # show node status
  monadctl stop            # stop monad services
  monadctl up              # spin up a new node
  monadctl down            # stop monad services

Examples:
  monadctl up --network mainnet --disk nvme1n1
  monadctl up --network mainnet --disk nvme1n1 --version 0.15.2
  monadctl up --network mainnet --disk nvme1n1 --deb /path/to/monad.deb
  monadctl logs --rpc --execution

Init/up options:
  --network <name>       # network to join (default: mainnet)
  --disk <device>         # data disk device name, e.g. nvme1n1 (default: nvme1n1)
  --loopback-disk <path>  # use a loopback file as the data disk instead of --disk
  --version <version>     # pin the monad package to a specific published apt version
  --deb <path>            # install the monad package from a local .deb file instead of apt
  --seq-num <n>           # self-record sequence number (default: 0)

Logs options (always follows, like tail -f):
  -b, --bft                       # monad-bft logs (default when no flag is given)
  -e, --exec, --execution         # monad-execution logs
  -r, --rpc                       # monad-rpc logs
  -a, --all                       # all three services
  Flags are additive; passing any of -b/-e/-r drops the bft-only default.

EOF
}

main() {
  case "${1:-}" in
  init)
    shift
    cmd_init "$@"
    ;;
  logs)
    shift
    cmd_logs "$@"
    ;;
  status)
    shift
    cmd_status "$@"
    ;;
  reset)
    shift
    cmd_reset "$@"
    ;;
  start) cmd_start ;;
  flush) cmd_flush ;;
  stop) cmd_stop ;;
  restart) cmd_restart ;;
  reload) cmd_reload ;;
  edit) cmd_edit ;;
  down) cmd_down ;;
  up)
    shift
    cmd_up "$@"
    ;;
  config) cmd_config ;;
  *) usage ;;
  esac
}

cmd_config() {
  cat "$CONFIG_FILE"
}

cmd_edit() {
  exec "${EDITOR:-vi}" $CONFIG_FILE </dev/tty >/dev/tty 2>&1
}

cmd_logs() {
  local bft=false execution=false rpc=false all=false any_selected=false

  while [[ $# -gt 0 ]]; do
    case "$1" in
    -b | --bft)
      bft=true
      any_selected=true
      shift
      ;;
    -e | --exec | --execution)
      execution=true
      any_selected=true
      shift
      ;;
    -r | --rpc)
      rpc=true
      any_selected=true
      shift
      ;;
    -a | --all)
      all=true
      shift
      ;;
    -*)
      echo "Unknown option for logs: $1" >&2
      exit 1
      ;;
    *)
      echo "Unknown argument for logs: $1" >&2
      exit 1
      ;;
    esac
  done

  if $all; then
    bft=true
    execution=true
    rpc=true
  elif ! $any_selected; then
    bft=true
  fi

  local units=()
  $bft && units+=("monad-bft")
  $execution && units+=("monad-execution")
  $rpc && units+=("monad-rpc")

  # kill the backgrounded journalctl/jq/sed pipelines below on exit so they
  # don't get orphaned if monadctl itself is killed/terminated
  trap 'kill $(jobs -p) 2>/dev/null' EXIT INT TERM

  local purple=$'\033[0;35m' blue=$'\033[0;34m' green=$'\033[0;32m' reset=$'\033[0m' tab=$'\t'
  local -A colors=(
    [monad-bft]="$purple"
    [monad-execution]="$blue"
    [monad-rpc]="$green"
  )

  # LEVEL keeps its severity color; target + payload are colorized by a
  # hash of the target field, so each target keeps a stable, distinct color
  local bft_level_filter='
    . as $raw
    | ["92","96","34","95","93","35","94","32","31","91","33","36"] as $palette
    | 36 as $width
    | 10 as $lvl_width
    | try (
      fromjson as $obj
      | ($obj.level // "") as $lvl
      | (
          if $lvl == "ERROR" then "[0;31m"
          elif $lvl == "WARN" then "[0;33m"
          elif $lvl == "INFO" then "[0;32m"
          elif $lvl == "DEBUG" then "[0;36m"
          elif $lvl == "TRACE" then "[0;90m"
          else "[0m" end
        ) as $lvlcolor
      | ($obj.target // "") as $target
      | ($target | explode | add // 0) as $hashsum
      | $palette[$hashsum % ($palette | length)] as $code
      | ("[0;" + $code + "m") as $svccolor
      | ($target | length) as $tlen
      | (if $tlen < $width then $target + (" " * ($width - $tlen)) else $target end) as $paddedtarget
      | ($lvl | length) as $llen
      | (if $llen < $lvl_width then $lvl + (" " * ($lvl_width - $llen)) else $lvl end) as $paddedlvl
      | ($obj | del(.timestamp, .level, .target) | tojson) as $message
      | "\($svccolor)\($paddedtarget)\($lvlcolor)\($paddedlvl)\($svccolor)\($message)[0m"
    ) catch $raw
  '

  local execution_ts_strip='s/^[0-9]{4}-[0-9]{2}-[0-9]{2} [0-9]{2}:[0-9]{2}:[0-9]{2}\.[0-9]+ \[[0-9]+\] //'

  local execution_level_filter='
    . as $raw
    | ["92","96","34","95","93","35","94","32","31","91","33","36"] as $palette
    | 36 as $svc_width
    | 10 as $lvl_width
    | try (
      capture("^(?<service>\\S+)\\s+(?<level>\\S+)\\s+(?<message>.*)$") as $m
      | ($m.service) as $service
      | ($m.level) as $level
      | ($m.message) as $message
      | ($service | sub("(:[0-9]+)$"; "")) as $service_key
      | (
          if ($level | test("ERROR")) then "[0;31m"
          elif ($level | test("WARN")) then "[0;33m"
          elif ($level | test("INFO")) then "[0;32m"
          elif ($level | test("DEBUG")) then "[0;36m"
          elif ($level | test("TRACE")) then "[0;90m"
          else "[0m" end
        ) as $lvlcolor
      | ($service_key | explode | add // 0) as $hashsum
      | $palette[$hashsum % ($palette | length)] as $code
      | ("[0;" + $code + "m") as $svccolor
      | ($service | length) as $slen
      | (if $slen < $svc_width then $service + (" " * ($svc_width - $slen)) else $service end) as $paddedsvc
      | ($level | length) as $llen
      | (if $llen < $lvl_width then $level + (" " * ($lvl_width - $llen)) else $level end) as $paddedlvl
      | "\($svccolor)\($paddedsvc)\($lvlcolor)\($paddedlvl)\($svccolor)\($message)[0m"
    ) catch $raw
  '

  for unit in "${units[@]}"; do
    if [[ "$unit" == "monad-bft" || "$unit" == "monad-rpc" ]]; then
      if [[ ${#units[@]} -gt 1 ]]; then
        journalctl -u "$unit" -f -o cat |
          jq --unbuffered -Rr "$bft_level_filter" |
          sed -u "s/^/${colors[$unit]}${unit}${reset}${tab}${tab}/" &
      else
        journalctl -u "$unit" -f -o cat | jq --unbuffered -Rr "$bft_level_filter" &
      fi
    else
      if [[ ${#units[@]} -gt 1 ]]; then
        journalctl -u "$unit" -f -o cat |
          sed -Eu "$execution_ts_strip" |
          jq --unbuffered -Rr "$execution_level_filter" |
          sed -u "s/^/${colors[$unit]}${unit}${reset}${tab}${tab}/" &
      else
        journalctl -u "$unit" -f -o cat |
          sed -Eu "$execution_ts_strip" |
          jq --unbuffered -Rr "$execution_level_filter" &
      fi
    fi
  done
  wait
}

cmd_status() {
  bash <(curl -fsSL "https://bucket.monadinfra.com/scripts/monad-status.sh") "$@"
}

cmd_start() {
  systemctl start monad-bft monad-execution monad-rpc
}

cmd_stop() {
  systemctl stop monad-bft monad-execution monad-rpc
}

cmd_flush() {
  cmd_stop
  bash /opt/monad/scripts/reset-workspace.sh
  journalctl --rotate && journalctl --vacuum-time=1s
}

cmd_restart() {
  cmd_stop && sleep 2 && cmd_start
}

cmd_reload() {
  monad-debug-node -c /home/monad/monad-bft/controlpanel.sock reload-config
}

cmd_up() {
  cmd_init "$@"
  cmd_hard_reset
}

cmd_down() {
  cmd_stop
}

cmd_reset() {
  local hard=false

  while [[ $# -gt 0 ]]; do
    case "$1" in
    --hard)
      hard=true
      shift
      ;;
    -*)
      echo "Unknown option for reset: $1" >&2
      exit 1
      ;;
    *)
      break
      ;;
    esac
  done

  if $hard; then
    cmd_hard_reset
  else
    cmd_soft_reset
  fi
}

cmd_soft_reset() {
  cmd_stop

  NETWORK=$(grep -Po '^network_name\s*=\s*"?\K[^"#]+' $CONFIG_FILE)
  MF_BUCKET=https://bucket.monadinfra.com
  VALIDATORS_FILE=/home/monad/monad-bft/config/validators/validators.toml

  curl -sSL "$MF_BUCKET/scripts/$NETWORK/download-forkpoint.sh" | bash
  curl "$MF_BUCKET/validators/$NETWORK/validators.toml" -o $VALIDATORS_FILE
  chown monad:monad $VALIDATORS_FILE

  cmd_start
}

cmd_hard_reset() {
  cmd_stop

  NETWORK=$(grep -Po '^network_name\s*=\s*"?\K[^"#]+' $CONFIG_FILE)
  MF_BUCKET="https://bucket.monadinfra.com"

  bash /opt/monad/scripts/reset-workspace.sh
  curl -fsSL "${MF_BUCKET}/scripts/${NETWORK}/restore-from-snapshot.sh" | bash

  cmd_start
}

cmd_init() {
  NETWORK=$DEFAULT_NETWORK
  DISK="nvme1n1"
  SEQ_NUM="0"
  VERSION=""
  DEB=""
  LOOPBACK_DISK=""

  while [[ $# -gt 0 ]]; do
    case "$1" in
    --network)
      NETWORK="$2"
      shift 2
      ;;
    --disk)
      DISK="$2"
      shift 2
      ;;
    --loopback-disk)
      LOOPBACK_DISK="$2"
      shift 2
      ;;
    --version)
      VERSION="$2"
      shift 2
      ;;
    --deb)
      DEB="$2"
      shift 2
      ;;
    --seq-num)
      SEQ_NUM="$2"
      shift 2
      ;;
    -*)
      echo "Unknown option for init: $1" >&2
      exit 1
      ;;
    *)
      echo "Unknown argument for init: $1" >&2
      exit 1
      ;;
    esac
  done

  if [[ -n "$DEB" && -n "$VERSION" ]]; then
    echo "Error: --deb and --version are mutually exclusive" >&2
    exit 1
  fi

  if [[ -n "$DEB" ]]; then
    if [[ ! -f "$DEB" ]]; then
      echo "Error: --deb file not found: $DEB" >&2
      exit 1
    fi
    DEB="$(readlink -f "$DEB")"
  fi

  set -x

  # Prepare loopback device
  if [[ -n "$LOOPBACK_DISK" ]]; then
    fallocate -l 100G "$LOOPBACK_DISK" || dd if=/dev/zero of="$LOOPBACK_DISK" bs=1M count=20480
    LOOP_DEVICE=$(losetup -j "$LOOPBACK_DISK" | cut -d: -f1)
    if [[ -z "$LOOP_DEVICE" ]]; then
      LOOP_DEVICE=$(losetup -fP --show "$LOOPBACK_DISK")
    fi
    DISK="$(echo $LOOP_DEVICE | cut -d '/' -f3)"
  fi

  systemctl stop monad-bft monad-execution monad-rpc || true

  cat <<EOF >/etc/apt/sources.list.d/category-labs.sources
Types: deb
URIs: https://pkg.category.xyz/
Suites: noble
Components: main
Signed-By: /etc/apt/keyrings/category-labs.gpg
EOF

  curl -fsSL https://pkg.category.xyz/keys/public-key.asc |
    gpg --dearmor --yes -o /etc/apt/keyrings/category-labs.gpg

  apt update -qq
  apt install -y -qq curl nvme-cli aria2 jq

  if [[ -n "$DEB" ]]; then
    apt install -y -qq --allow-downgrades --allow-change-held-packages "$DEB"
  else
    if [[ "$VERSION" == '' ]]; then
      VERSION=$(curl -fsSL "$DOC_URL" | jq -r --arg network "$NETWORK" '.[$network].monad_version')
    fi
    apt install -y -qq --allow-downgrades --allow-change-held-packages monad="$VERSION"
  fi

  apt-mark hold monad

  VERSION=$(dpkg-query -W -f='${Version}' monad)

  useradd -m -s /bin/bash monad || true
  mkdir -p /home/monad/monad-bft/config \
    /home/monad/monad-bft/ledger \
    /home/monad/monad-bft/config/forkpoint \
    /home/monad/monad-bft/config/validators

  TRIEDB_DRIVE="/dev/$DISK"
  parted -s $TRIEDB_DRIVE mklabel gpt
  parted -s $TRIEDB_DRIVE mkpart triedb 0% 100%
  sleep 1
  PARTUUID=$(lsblk -o PARTUUID $TRIEDB_DRIVE | tail -n 1)
  echo "Disk PartUUID: ${PARTUUID}"
  echo "ENV{ID_PART_ENTRY_UUID}==\"$PARTUUID\", MODE=\"0666\", SYMLINK+=\"triedb\"" |
    tee /etc/udev/rules.d/99-triedb.rules
  sleep 2
  udevadm trigger
  sleep 2
  udevadm control --reload
  sleep 2
  udevadm settle
  sleep 2
  ls -l /dev/triedb

  monad-mpt --storage /dev/triedb --create

  ufw allow ssh
  ufw allow 8000
  ufw allow 8001
  ufw --force enable

  OTEL_VERSION="0.139.0"
  OTEL_CHECKSUM="1a1576dde7d51fa7094f4963ceaff37c91ac7b9c9593ba735a3a328ec6f8acd9"
  OTEL_PACKAGE="https://github.com/open-telemetry/opentelemetry-collector-releases/releases/download/v${OTEL_VERSION}/otelcol_${OTEL_VERSION}_linux_amd64.deb"
  OTEL_DEB="/tmp/otelcol_linux_amd64.deb"

  curl -fsSL "$OTEL_PACKAGE" -o "$OTEL_DEB"

  if echo "${OTEL_CHECKSUM}  ${OTEL_DEB}" | sha256sum --check --quiet; then
    dpkg -i "$OTEL_DEB"
    cp /opt/monad/scripts/otel-config.yaml /etc/otelcol/config.yaml
    systemctl restart otelcol
  else
    echo "Checksum verification failed — aborting install." >&2
    exit 1
  fi

  MF_BUCKET=https://bucket.monadinfra.com
  curl -fsSL -o /home/monad/.env "$MF_BUCKET/config/${NETWORK}/latest/.env.example"
  curl -fsSL -o /home/monad/monad-bft/config/node.toml "$MF_BUCKET/config/${NETWORK}/latest/full-node-node.toml"

  sed -i "s|^KEYSTORE_PASSWORD=$|KEYSTORE_PASSWORD='$(openssl rand -base64 32)'|" /home/monad/.env
  set +x
  source /home/monad/.env
  set -x
  mkdir -p /opt/monad/backup/
  echo "Keystore password: ${KEYSTORE_PASSWORD}" >/opt/monad/backup/keystore-password-backup

  rm /home/monad/monad-bft/config/id-secp || true
  rm /home/monad/monad-bft/config/id-bls || true

  monad-keystore create \
    --key-type secp \
    --keystore-path /home/monad/monad-bft/config/id-secp \
    --password "${KEYSTORE_PASSWORD}" >/opt/monad/backup/secp-backup

  monad-keystore create \
    --key-type bls \
    --keystore-path /home/monad/monad-bft/config/id-bls \
    --password "${KEYSTORE_PASSWORD}" >/opt/monad/backup/bls-backup

  grep "public key" /opt/monad/backup/secp-backup /opt/monad/backup/bls-backup |
    tee /home/monad/pubkey-secp-bls

  set +x
  source /home/monad/.env
  set -x
  NODE_IP="$(curl -s4 ifconfig.me)"
  if dpkg --compare-versions "$VERSION" le "0.15.1"; then
    ADDRESS_FLAGS=(--address "${NODE_IP}:8000")
  else
    ADDRESS_FLAGS=(--ip "$NODE_IP" --tcp-port 8000 --udp-port 8000)
  fi

  sig_out="$(
    monad-sign-name-record \
      "${ADDRESS_FLAGS[@]}" \
      --authenticated-udp-port 8001 \
      --keystore-path /home/monad/monad-bft/config/id-secp \
      --password "${KEYSTORE_PASSWORD}" \
      --self-record-seq-num "${SEQ_NUM}"
  )"

  node_name_val="$(hostname)"
  self_address=$(printf '%s\n' "$sig_out" | grep '^self_address' | cut -d'"' -f2)
  self_tcp_port=$(printf '%s\n' "$sig_out" | grep '^self_tcp_port' | awk '{print $3}' || true)
  if [[ -n "$self_tcp_port" && "$self_address" != *:* ]]; then
    self_address="${self_address}:${self_tcp_port}"
  fi
  self_record_seq_num=$(printf '%s\n' "$sig_out" | grep '^self_record_seq_num' | awk '{print $3}')
  self_name_record_sig=$(printf '%s\n' "$sig_out" | grep '^self_name_record_sig' | cut -d'"' -f2)

  sed -i \
    -e "s|^node_name = \".*\"|node_name = \"$node_name_val\"|" \
    -e "s|^self_address = \".*\"|self_address = \"$self_address\"|" \
    -e "s|^self_record_seq_num = .*|self_record_seq_num = $self_record_seq_num|" \
    -e "s|^self_name_record_sig = \".*\"|self_name_record_sig = \"$self_name_record_sig\"|" \
    /home/monad/monad-bft/config/node.toml

  chown -R monad:monad /home/monad/
  systemctl enable monad-bft monad-execution monad-rpc
}

main "$@"
